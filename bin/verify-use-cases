#!/usr/bin/env bash
set -eo pipefail

repository_directory="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repository_directory"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  echo "nvm is required at $NVM_DIR/nvm.sh" >&2
  exit 1
fi

. "$NVM_DIR/nvm.sh" --no-use
requested_node_version="$(tr -d '[:space:]' < .nvmrc)"
nvm use --silent "v$requested_node_version"

actual_node_version="$(node --version)"
echo "Node $actual_node_version"
if [ "$actual_node_version" != "v22.22.1" ]; then
  echo "Expected Node v22.22.1" >&2
  exit 1
fi

npm run verify:use-cases
